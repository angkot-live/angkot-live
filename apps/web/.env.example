VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Development uses the Vite proxy. Production should use the same-origin /api proxy.
VITE_API_URL=/api
# Optional: your own OSRM pedestrian routing endpoint.
# VITE_WALK_ROUTING_URL=https://your-router.example/route/v1/foot

# Enable only with the matching local backend flag and seeded demo accounts.
VITE_ENABLE_DEMO_LOGIN=false
# npm run local:env generates a relative VITE_SUPABASE_URL=/supabase for LAN access.
LOCAL_HTTPS=false
LOCAL_WEB_PORT=5173
LOCAL_API_PORT=8080
