SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WEB_ORIGIN=http://localhost:5173
API_ADDR=:8080
ROUTES_FILE=../web/src/data/angkot-routes.json

# Local demo only; generated by npm run local:env.
ENABLE_DEMO_LOGIN=false
# Comma-separated exact origins for local phone + desktop.
WEB_ORIGINS=http://localhost:5173
# Same-origin Supabase proxy for private file URLs on another device.
SUPABASE_PUBLIC_URL=/supabase
