  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "GPS": {
        "type": "object",
        "required": [
          "position",
          "accuracy",
          "sampledAt"
        ],
        "properties": {
          "position": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "accuracy": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 50
          },
          "sampledAt": {
            "type": "integer",
            "description": "Unix milliseconds, at most 15 seconds old"
          }
        }
      },
      "Duty": {
        "type": "object",
        "required": [
          "mode",
          "session"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "narik",
              "ngetem",
              "istirahat",
              "offline"
            ]
          },
          "session": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100
          },
          "telemetrySource": {
            "type": "string",
            "enum": [
              "gps",
              "simulation"
            ],
            "default": "gps",
            "description": "Sumber posisi. simulation hanya diterima ketika demo Supabase lokal aktif."
          }
        }
      },
      "Megat": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GPS"
          },
          {
            "type": "object",
            "required": [
              "routeId",
              "destination",
              "key"
            ],
            "properties": {
              "routeId": {
                "type": "string"
              },
              "destination": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Register": {
        "type": "object",
        "required": [
          "name",
          "email",
          "phone",
          "password",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "Route": {
        "type": "object",
        "required": [
          "code",
          "name",
          "origin",
          "destination",
          "color",
          "segments"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                },
                "description": "[latitude, longitude]"
              }
            }
          },
          "endstops": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "position"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "position": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  },
                  "description": "[latitude, longitude]"
                },
                "isTerminal": {
                  "type": "boolean"
                }
              }
            }
          },
          "fareStandard": {
            "type": "integer",
            "minimum": 0
          },
          "fareStudent": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "x-tracking": {
    "publishMs": 3000,
    "staleMs": 15000,
    "removeMs": 30000,
    "dutyTimeoutMs": 60000,
    "snapshotMs": 1000,
    "browserWatchdogMs": 8000,
    "telemetrySource": [
      "gps",
      "simulation"
    ],
    "simulator": "Only explicit demo mode with loopback Supabase. Approval, duty/session, rate and GPS validation still apply. Vehicle and history retain provenance. GPS remains the default.",
    "websocketAck": "type=ack, id, serverTime, sampledAt. Errors preserve the request id.",
    "jwtRefresh": "Browser reconnects with fresh Auth token. Expiry of an old socket cannot stop a newer authenticated publisher."
  },
  "x-demo-completion": {
    "tripFare": "Snapshot routes.fare_standard at first boarding, stable on retry.",
    "tripProvenance": "passenger_trips.telemetry_source preserves gps/simulation.",
    "reportEvidence": "Owner and Storage object existence required; up to five objects.",
    "notifications": "kind=report and related_report_id. report_updates preference controls future messages only.",
    "privateFiles": "Signed URL 120s; no API/Auth/Storage/token caching in service worker."
  }
}
